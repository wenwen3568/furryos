#!/bin/sh

# FurryOS 6120 - SDDM login experience layer (assets/sddm -> target system).
#
# Owner of the affected files: sddm-experience (docs/CONTRACTS.md).
#
# Injection strategy
# ------------------
# The layer ships its own installer, assets/sddm/install-sddm-theme.sh, which
# sddm-experience has already dry-run verified. It is authoritative because:
#
#   * it is idempotent (safe to re-run)
#   * it copies the theme to /usr/share/sddm/themes/furryos
#   * it applies chmod -R a+rX so the unprivileged `sddm` user can read it
#   * it writes /etc/sddm.conf with Current=furryos
#
# CONTRACTS.md assigns /etc/sddm.conf to sddm-experience, so we do NOT
# generate that file ourselves - we let the layer's script own it. This hook
# only stages the layer and invokes the script.
#
# A fallback installer is used if the layer's script is absent, so a missing
# script degrades to "theme installed, no sddm.conf" rather than failing the
# whole build.

set -e

. /live-build/config/hooks/normal/furryos-common.sh

SRC="${FURRYOS_ASSETS}/sddm"

furryos_log "Installing SDDM login experience layer from ${SRC}"

if [ ! -d "${SRC}" ]
then
	furryos_warn "sddm layer not staged; skipping (SDDM will use the default theme)"
	exit 0
fi

# --- locate the theme directory -------------------------------------------
# The layer's theme lives at assets/sddm/furryos/ (contains Main.qml). A bare
# Main.qml directly under assets/sddm/ is also accepted.
THEME_DIR=""
if [ -f "${SRC}/furryos/Main.qml" ]
then
	THEME_DIR="${SRC}/furryos"
elif [ -f "${SRC}/Main.qml" ]
then
	THEME_DIR="${SRC}"
else
	for CANDIDATE in "${SRC}"/*; do
		if [ -f "${CANDIDATE}/Main.qml" ]
		then
			THEME_DIR="${CANDIDATE}"
			break
		fi
	done
fi

if [ -z "${THEME_DIR}" ]
then
	furryos_warn "no SDDM theme with Main.qml found under ${SRC}"
	exit 0
fi

furryos_log "using theme directory ${THEME_DIR}"

# --- preferred path: the layer's own installer -----------------------------
if [ -x "${SRC}/install-sddm-theme.sh" ]
then
	furryos_log "invoking the layer's install-sddm-theme.sh"
	# The script takes (theme dir, prefix). Inside the chroot the prefix is /.
	"${SRC}/install-sddm-theme.sh" "${THEME_DIR}" / || \
		furryos_warn "install-sddm-theme.sh returned non-zero"
elif [ -e "${SRC}/install-sddm-theme.sh" ]
then
	# Not executable (a copy may have dropped the bit); run it via sh.
	sh "${SRC}/install-sddm-theme.sh" "${THEME_DIR}" / || \
		furryos_warn "install-sddm-theme.sh returned non-zero"
else
	# --- fallback installer ---------------------------------------------
	furryos_warn "layer installer not found; using build-verify fallback"
	install -d -m 0755 /usr/share/sddm/themes/furryos
	cp -a "${THEME_DIR}/." /usr/share/sddm/themes/furryos/
	chmod -R a+rX /usr/share/sddm/themes/furryos

	if [ -e "${SRC}/sddm.conf" ]
	then
		furryos_install_file "${SRC}/sddm.conf" /etc/sddm.conf 0644
		furryos_log "installed layer-provided /etc/sddm.conf"
	else
		cat > /etc/sddm.conf <<EOF
# FurryOS SDDM configuration (generated by build-verify hook 6120 fallback).
[Theme]
Current=furryos
ThemeDir=/usr/share/sddm/themes

[General]
Numlock=on
EOF
		furryos_log "created fallback /etc/sddm.conf (Current=furryos)"
	fi
fi

# --- verify the result -----------------------------------------------------
if [ -f /usr/share/sddm/themes/furryos/Main.qml ]
then
	furryos_log "theme present at /usr/share/sddm/themes/furryos/Main.qml"
else
	furryos_warn "theme Main.qml not found after install"
fi

if [ -f /etc/sddm.conf ]
then
	furryos_log "/etc/sddm.conf -> $(grep -E '^Current=' /etc/sddm.conf || echo '<no Current key>')"
else
	furryos_warn "/etc/sddm.conf was not created"
fi

# --- QML runtime dependencies ---------------------------------------------
# The theme is pure QtQuick 2 + QtQml + QtQuick.Layouts (no org.kde.plasma.*,
# no SddmComponents), so the only real requirements are the Qt5 QML runtime
# pulled in by the `sddm` package, plus the SVG image format plugin for the
# paw decoration. Warn (do not fail) if they are missing, because the package
# list is owned by the build, not by this layer.
if [ ! -e /usr/lib/x86_64-linux-gnu/qt5/qml/QtQuick ]
then
	furryos_warn "QtQuick QML runtime not detected in chroot"
fi

for SVGPLUGIN in /usr/lib/x86_64-linux-gnu/qt5/plugins/imageformats/libqsvg.so \
                 /usr/lib/x86_64-linux-gnu/qt5/plugins/imageformats/libqsvg.so.5; do
	if [ -e "${SVGPLUGIN}" ]
	then
		furryos_log "SVG image format plugin present: ${SVGPLUGIN}"
		break
	fi
done

furryos_log "SDDM login experience layer installed."
